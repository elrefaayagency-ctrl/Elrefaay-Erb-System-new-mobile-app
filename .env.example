# ─── نسخة نموذجية لمتغيرات البيئة — انسخها لـ .env واملأ القيم الحقيقية ───
# لا ترفع ملف .env نفسه أبداً لأي مكان (Git, رسائل, مشاركة ملفات).
# هذا الملف (.env.example) فقط هو الآمن للمشاركة/الرفع لأنه بدون قيم حقيقية.

# ── قاعدة البيانات (PostgreSQL عبر Supabase أو أي مزوّد آخر) ──
# احصل عليه من: Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres
# اتركه فاضي/true افتراضياً (مطلوب لمعظم مزوّدي Postgres السحابيين). خليه false فقط لو قاعدة بياناتك محلية بدون SSL
DATABASE_SSL=true
# عدد الاتصالات المتزامنة القصوى في الـ pool — 10 كافية لحمل متوسط، زوّدها لو السيرفر بطيء تحت ضغط
DATABASE_POOL_SIZE=10

# ── الأمان ──
# مفتاح توقيع JWT — لازم يكون عشوائي وطوله 32 حرف على الأقل. السيرفر يرفض
# يشتغل من غيره. ولّده بأمر: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# قائمة الـ origins المسموح لها بالوصول للـ API، مفصولة بفاصلة (اختياري).
# لو سايبها فاضية، الـ API بيقبل من أي origin (مقبول لو الفرونت اند بيتقدّم
# من نفس السيرفر). حددها في الإنتاج لو الفرونت اند على نطاق منفصل، مثال:
# ALLOWED_ORIGINS=https://erp.alrifai-lighting.com,https://www.alrifai-lighting.com
ALLOWED_ORIGINS=

# ── السيرفر ──
PORT=5000
NODE_ENV=production

# ── إشعارات تيليجرام (اختياري — لو مش محتاجه اتركهم فاضيين) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── النسخ الاحتياطي (اختياري — القيم الافتراضية شغالة كويس بدونها) ──
# BACKUP_DIR=/path/to/backups
# BACKUP_RETENTION_DAYS=14

